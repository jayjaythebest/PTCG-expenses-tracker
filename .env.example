VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
GEMINI_API_KEY=your_gemini_api_key

# --- Server-side only (api/weekly-summary.ts + Vercel Cron) ---
# Do NOT prefix these with VITE_ — they must stay server-side only.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
CRON_SECRET=a_random_secret_string

# --- AI provider fallback for card scanning (api/_lib/ai.ts) ---
# The scan endpoint tries providers in order and falls through on quota/error,
# so scanning keeps working when Gemini's free daily limit is hit. Set at least
# one fallback key in Vercel (free tiers available for both).
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
# Optional overrides:
# AI_PROVIDER_ORDER=gemini,groq,openrouter
# GEMINI_VISION_MODEL=gemini-2.5-flash
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
